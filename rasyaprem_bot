# ============================================
#   COMMAND: /gmail
# ============================================
async def gmail_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id

    if not context.args:
        await update.message.reply_text(
            "❌ Format salah!\n\n"
            "Contoh:\n"
            "`/gmail target@gmail.com`",
            parse_mode="Markdown",
        )
        return

    email = context.args[0].strip().lower()

    if not email.endswith("@gmail.com"):
        await update.message.reply_text(
            "❌ *MENU INI KHUSUS GMAIL.COM*\n\n"
            "Silakan pake:\n"
            "`/gmail target@gmail.com`",
            parse_mode="Markdown",
        )
        return

    await update.message.reply_text(f"⏳ Mengirim link ke {email}...")

    try:
        r = requests.post(
            ENDPOINT_SEND,
            json={"gmail": email},
            headers={
                "Content-Type": "application/json",
                "X-API-Key": API_KEY,
            },
            timeout=30,
        )

        user_data[user_id] = email

        await update.message.reply_text(
            f"✅ *Link terkirim!*\n\n"
            f"📧 Email: `{email}`\n\n"
            f"Langkah selanjutnya:\n"
            f"1. Cek inbox / spam\n"
            f"2. Copy link verifikasi\n"
            f"3. Ketik:\n"
            f"`/verif <link>`",
            parse_mode="Markdown",
        )

    except Exception as e:
        await update.message.reply_text(f"❌ Gagal: {e}")


