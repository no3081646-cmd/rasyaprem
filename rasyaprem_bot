            "`/temp user@mail.tm`",
            parse_mode="Markdown",
        )
        return

    if not context.args:
        await update.message.reply_text(
            "❌ Format salah!\n\n"
            "Contoh:\n"
            "`/verif https://alight-creative.firebaseapp.com/...`",
            parse_mode="Markdown",
        )
        return

    link = context.args[0].strip()
    email = user_data[user_id]

    await update.message.reply_text("⏳ Memverifikasi link...")

    try:
        r = requests.post(
            ENDPOINT_VERIF,
